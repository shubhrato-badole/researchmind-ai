# ResearchMind AI: frontend configuration
# Copy to frontend/.env before running `npm run dev` or building the Docker image.

# API base URL.
#   /api is proxied to the backend by the Vite dev server (see vite.config.ts)
#   and by Nginx in Docker (see docker/nginx.conf).
# For a separately hosted backend, use its full URL, e.g. https://api.example.com
VITE_API_URL=/api

# Razorpay public key id (only needed for the Pro checkout flow)
VITE_RAZORPAY_KEY_ID=
