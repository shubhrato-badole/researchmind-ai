# ResearchMind AI: backend configuration
# Copy to backend/.env and fill in the values. Never commit the real .env file.

# ───────────────────────── Required ─────────────────────────

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret for signing JWTs and sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Redis: OTPs, daily quotas, BM25 cache invalidation.
# Docker Compose (default):  redis://redis:6379/0
# Local backend (no Docker): redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# PostgreSQL. Docker Compose overrides this automatically.
# For a local backend, use:
#   postgresql://postgres:postgres@localhost:5432/researchmind
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/researchmind

# Chroma Cloud (vector store): https://www.trychroma.com/
CHROMA_API_KEY=
CHROMA_TENANT=
CHROMA_DATABASE=

# AWS S3 (original uploaded files). The region is set to ap-south-1 in
# backend/ingestion/s3_utils.py, so create the bucket there.
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ───────────────────────── Optional ─────────────────────────

# Where the web app is served. Used for CORS and the post-login redirect.
#   Docker web app:  http://localhost
#   Vite dev server: http://localhost:5173
FRONTEND_URL=http://localhost

# OTP emails. Leave blank to print OTPs in the backend logs instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google sign-in. Authorized redirect URI:
#   http://localhost:8000/auth/google/callback   (use your backend URL in production)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# reCAPTCHA verification for sign-up and login (skipped when blank)
RECAPTCHA_SECRET_KEY=

# Razorpay (needed only for Pro upgrades)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cross-encoder used for reranking (default shown)
# RERANKER_MODEL=BAAI/bge-reranker-base
